# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fettl"

# JWT
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Public API URL (used in magic links and uploaded asset URLs)
API_URL="http://localhost:3000"

# Email delivery (required in production)
RESEND_API_KEY=""
EMAIL_FROM="Fettl <noreply@example.com>"

# S3 compatible object storage
S3_ENDPOINT=""
S3_REGION="us-east-005"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="fettl"
S3_PUBLIC_URL=""

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
MAX_GROUP_MEMBERS=50

# VPA Encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VPA_ENCRYPTION_KEY="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2"
